    "out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.23,1,.32,1)",
      "evidence": [
        "src.css.tokens",
        "spec.0.css-vars"
      ]
    },
    "inOut": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.77,0,.175,1)",
      "evidence": [
        "src.css.tokens",
        "spec.0.css-vars"
      ]
    },
    "ease": {
