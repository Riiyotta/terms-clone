        "src.css.shell-vars"
      ]
    },
    "navKeyboardFocus": {
      "$type": "transition",
      "$value": {
        "trigger": "keyboard focus on a rail link sets [data-instant] on the rail; pointer entry clears it",
        "property": "background",
        "duration": "{duration.button}",
        "colorAndRing": "switch instantly",
        "focusedOutlineOffset": "0"
      },
      "evidence": [
        "pages.corr-nav-focus",
        "src.css.nav-instant",
        "src.navbar.instant"
      ]
    },
    "commitLink": {
      "$type": "transition",
      "$value": {
        "property": "color + text-decoration",
        "from": "{color.neutral.changelogMuted}",
        "to": "{color.base.black}",
