        "duration": "{duration.instant}"
      },
      "evidence": [
        "pages.changelog-typo",
        "src.css.commit-link"
      ]
    },
    "photoCard": {
      "$type": "transition",
      "$value": {
        "properties": [
          "transform",
          "box-shadow"
        ],
        "liftPx": -6,
        "grow": 1.015,
        "tiltFactor": 0.6,
        "shadowTo": "{elevation.photoShadowHover}",
        "duration": "{duration.photo}",
        "easing": "{easing.photo}",
        "when": "(hover: hover) and (pointer: fine), and :active"
      },
      "evidence": [
        "pages.photo-stack-motion",
        "src.css.photo-stack"
      ]
    }
