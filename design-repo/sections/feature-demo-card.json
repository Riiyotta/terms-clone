  "tone": "surface",
  "constraints": {
    "onePerPagePerVariant": true,
    "variantOrder": [
      "draft",
      "questions",
      "comments"
    ],
    "group": "previews"
  },
  "variantDecision": "One section type with three variants, not three types: all three share one frame (PreviewFrame + Squircle), one header grid, one playback button, one loop engine (usePreviewTimeline) and one wrapper grid (LP_previews). Their stage content and timelines differ, so content and motion are closed per variant (keyed on (section, variant)).",
