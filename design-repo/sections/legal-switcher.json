{
  "id": "legal.switcher",
  "kind": "section",
  "category": "LEGAL",
  "purpose": "Two-link switcher between the legal documents; the current page's link is aria-current (500, underline offset 4).",
  "implementedBy": "src/components/LegalDocument.jsx",
  "region": "main",
  "tone": "app",
  "constraints": {
    "onePerPage": true
  },
  "variants": {
    "two-links": {
      "anchorId": null,
      "content": {
        "links": {
          "type": "tuple",
          "items": [
            {
              "type": "object",
              "fields": {
                "label": {
                  "type": "text",
                  "maxWords": 3,
                  "maxChars": 16,
                  "evidence": [
                    "pages.legal-layout"
                  ]
                },
                "href": {
                  "type": "href",
                  "kinds": [
                    "route"
                  ],
                  "evidence": [
                    "pages.legal-layout"
                  ]
                }
              }
            },
            {
              "type": "object",
              "fields": {
                "label": {
                  "type": "text",
                  "maxWords": 3,
                  "maxChars": 16,
                  "evidence": [
                    "pages.legal-layout"
                  ]
                },
                "href": {
                  "type": "href",
                  "kinds": [
                    "route"
                  ],
                  "evidence": [
                    "pages.legal-layout"
                  ]
                }
              }
            }
          ],
          "evidence": [
            "pages.legal-layout"
          ]
        }
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "no-motion"
      },
      "motionEvidence": [
        "pages.legal-layout"
      ],
      "tones": [
        "app"
      ]
    }
  },
  "responsive": {
    "desktop": [
      "flex, wrap, gap 16, 24 tall"
    ]
  },
  "responsiveEvidence": [
    "pages.legal-layout",
    "src.css.legal"
  ],
  "composes": [
    "primitive.inline-link"
  ],
  "evidence": [
    "pages.legal-layout",
    "src.legal.composition"
  ],
  "copyPolicy": "Short UI fields: budgets are the measured verbatim strings (CLONE_SPEC_PAGES.md). Long-form fields (type 'prose', longForm true) carry STRUCTURE and BUDGETS only: maxWords = the spec's word count, maxChars = ceil(7.5 x maxWords) (derived; the long-form was never transcribed), maxLinks = measured link slots. Write original copy; never source terms.so's long-form (fingerprinted in schema/protected-content.json). Enforced per instance by MAX_WORDS, MAX_CHARS and LINK_SLOTS."
}
