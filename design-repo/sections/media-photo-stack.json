{
  "id": "media.photo-stack",
  "kind": "section",
  "category": "MEDIA",
  "purpose": "Three stacked, tilted photo cards; clicking the front card sends it to the back, clicking another brings it to the front. The photos MUST be the target project's own real, consented team/workplace photos (role photo.studio-people): never the source's, never AI-generated people.",
  "implementedBy": "src/components/PhotoStack.jsx",
  "region": "main",
  "tone": "hero",
  "constraints": {
    "onePerPage": true
  },
  "slotGeometry": {
    "note": "fixed per index; only z-order, --depth and data-front change on click",
    "slots": [
      {
        "dx": -0.9,
        "dy": 0.15,
        "rot": "-8deg",
        "w": 0.92,
        "aspect": "3 / 4"
      },
      {
        "dx": 0.05,
        "dy": -0.1,
        "rot": "2deg",
        "w": 1,
        "aspect": "4 / 5"
      },
      {
        "dx": 0.95,
        "dy": 0.2,
        "rot": "7deg",
        "w": 1.08,
        "aspect": "5 / 4"
      }
    ],
    "evidence": [
      "pages.about-photos",
      "src.photostack"
    ]
  },
